<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GuardianLink"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Scan the QR code once to pair this device."/>

        <Button
            android:id="@+id/scanQrButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Scan Pairing QR"/>

        <EditText
            android:id="@+id/serverUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Server URL"/>

        <EditText
            android:id="@+id/pairingId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pairing ID"/>

        <EditText
            android:id="@+id/deviceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Device name"/>

        <Button
            android:id="@+id/pairButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pair Manually"/>

        <Button
            android:id="@+id/heartbeatButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send Heartbeat"/>

        <Button
            android:id="@+id/checkCommandButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check Commands"/>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Not paired"/>

    </LinearLayout>

</ScrollView>
